pipeline {
    agent any

    stages {
        stage('Hostname') {
            steps {
                sh 'hostname'
            }
        }

        stage('Server Date Add') {
            steps {
                sh 'date'
            }
        }

        stage('CPU Details') {
            steps {
                sh "lscpu | grep -E 'Model name|Architecture|CPU\\(s\\)|Thread|Core|Socket'"
            }
        }

        stage('Memory Usage') {
            steps {
                sh 'free -h'
            }
        }

        stage('Disk Usage Details') {
            steps {
                sh "df -hT | grep -E '^/dev'"
            }
        }
    }
}
